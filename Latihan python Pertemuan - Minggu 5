# Brute force mencari nilai rahasia a
# Parameter: p = 23, g = 5, A = 8

p = 23
g = 5
A = 8

# Cari nilai a dengan brute force
a_found = None
for a in range(1, p):  # coba semua kemungkinan dari 1 sampai p-1
    if pow(g, a, p) == A:
        a_found = a
        break

if a_found is not None:
    print("Nilai rahasia a =", a_found)
else:
    print("Tidak ditemukan nilai a")
